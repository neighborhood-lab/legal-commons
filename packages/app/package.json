{
  "name": "@legal-commons/app",
  "version": "0.1.0",
  "private": true,
  "description": "Express API server for Legal Commons",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@legal-commons/core": "*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.53.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.55.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.55.0",
    "@opentelemetry/instrumentation-http": "0.55.0",
    "@opentelemetry/sdk-node": "0.55.0",
    "@sentry/node": "10.23.0",
    "@sentry/profiling-node": "10.23.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "isomorphic-dompurify": "2.31.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1",
    "pino": "10.1.0",
    "pino-http": "10.3.0",
    "prom-client": "15.1.3",
    "puppeteer": "^24.29.1",
    "rate-limit-redis": "4.2.3",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "zod": "^4.1.12",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.6",
    "@vitest/coverage-v8": "4.0.8",
    "happy-dom": "20.0.10",
    "supertest": "7.1.4",
    "tsx": "4.19.2",
    "vitest": "4.0.8"
  }
}
